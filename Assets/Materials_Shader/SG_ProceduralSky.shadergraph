{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d23b55e41fa84fc9a55f3dc3f98cb36b",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "StarNoise3D_2 (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 523.2000732421875,
            "y": 16.800039291381837,
            "width": 227.20001220703126,
            "height": 349.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "fb97564dc6094b9fa0c6656ccebe752b"
        },
        {
            "m_Id": "eaccab1b10ae4512a69f6d9f71ad4154"
        },
        {
            "m_Id": "846edac849f4431bb3b2b2f421625de6"
        },
        {
            "m_Id": "4753390a1ffb4a008cdb1843603e09e1"
        },
        {
            "m_Id": "df05ac00889a4ae5a5db2fa8cb0c76ba"
        },
        {
            "m_Id": "504b795c06914fde9785a4fc3b7bfdde"
        },
        {
            "m_Id": "4b33f32e4d004f2aae9b3e6a4f8b9c37"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "StarNoise3D_2",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 p = Pos * Scale;\r\nfloat3 cell = floor(p);\r\nfloat3 localPos = frac(p);\r\n\r\n// 1. Maschera Volumetrica degli Ammassi (Interferenza distorta)\r\nfloat3 mPos = Pos * MacroScale;\r\nfloat mask = sin(mPos.x + sin(mPos.y)) * cos(mPos.y + cos(mPos.z)) * sin(mPos.z + sin(mPos.x));\r\n// Normalizziamo il risultato tra 0 e 1\r\nmask = saturate(mask * 0.5 + 0.5);\r\n// Applichiamo il contrasto per scavare i vuoti cosmici\r\nmask = pow(mask, MacroContrast); \r\n\r\n// 2. Modulazione Dinamica del Threshold (La chiave tecnica)\r\n// Se mask = 1 (Ammasso), usiamo il tuo Threshold (es. 0.90 -> tante stelle).\r\n// Se mask = 0 (Vuoto), alziamo il Threshold a 0.999 (le stelle smettono di generarsi).\r\nfloat dynamicThreshold = lerp(0.999, Threshold, mask);\r\n\r\n// 3. Generazione e calcolo della singola stella\r\nfloat rand = frac(sin(dot(cell, float3(12.9898, 78.233, 37.719))) * 43758.5453);\r\nfloat dist = length(localPos - 0.5);\r\nfloat shape = saturate(1.0 - (dist * StarSize));\r\n\r\n// 4. Calcolo luminosità finale con prevenzione della divisione per zero\r\nfloat brightness = saturate((rand - dynamicThreshold) / max(0.0001, 1.0 - dynamicThreshold));\r\n\r\nOut = shape * brightness;\n"
}

