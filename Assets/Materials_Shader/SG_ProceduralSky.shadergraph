{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ad2e81a90bc04c789fc23eb400e6192b",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PlanarProjector (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 618.4000854492188,
            "y": -1777.60009765625,
            "width": 242.39990234375,
            "height": 124.800048828125
        }
    },
    "m_Slots": [
        {
            "m_Id": "659538df794647d496abd9fdb1e2546b"
        },
        {
            "m_Id": "92480c313a684d9390fcb933b4d15ae3"
        },
        {
            "m_Id": "7acfea3e23f549268cb3715980872625"
        },
        {
            "m_Id": "73cdaf46a63e409485fef08c1581f34b"
        },
        {
            "m_Id": "cb5cc18eb084425584c57be8878207be"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PlanarProjector",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1. Normalizziamo i vettori per avere direzioni perfette\r\nfloat3 p = normalize(Pos);\r\nfloat3 forward = normalize(Dir);\r\n\r\n// 2. Creiamo un piano perfettamente dritto basato sulla direzione scelta (Evitiamo il Gimbal Lock)\r\nfloat3 arbitraryUp = abs(forward.y) > 0.999 ? float3(0, 0, 1) : float3(0, 1, 0);\r\nfloat3 right = normalize(cross(arbitraryUp, forward));\r\nfloat3 up = cross(forward, right);\r\n\r\n// 3. Proiettiamo i pixel della sfera su questo nuovo piano dritto\r\nfloat u = dot(p, right) * Size;\r\nfloat v = dot(p, up) * Size;\r\n\r\n// 4. Centriamo la texture\r\nOutUV = float2(u, v) + 0.5;\r\n\r\n// 5. Creiamo una maschera 3D perfetta (1 al centro esatto, scende verso 0 ai lati)\r\nSphericalMask = dot(p, forward);"
}

